#!/usr/bin/env python3
"""RE protocol entry script — no PYTHONPATH required.

Use:
  ./tools/re init
  ./tools/re record --help
  ./tools/re state
  ./tools/re references add ...

Equivalent to:
  PYTHONPATH=.../tools python3 -m researchlog <verb> [...]

The script is meant to be invoked from inside the research-engineering
repository (or copied into an EsaStudy cwd). It exists so callers never
have to set PYTHONPATH or know the package layout.
"""
from __future__ import annotations

import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(_HERE))

from researchlog import cli  # noqa: E402  (sys.path mutated above on purpose)

if __name__ == "__main__":
    sys.exit(cli.main(sys.argv[1:]))
